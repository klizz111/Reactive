# ─── Wallet ────────────────────────────────────────────────────────────────────
# Private key for signing transactions (no 0x prefix needed)
PRIVATE_KEY=your_private_key_here

# ─── RPC URLs ──────────────────────────────────────────────────────────────────
# Ethereum Sepolia testnet (origin & destination chain for basic demo)
# Get a free RPC from Alchemy, Infura, or use the public one below
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Reactive Network Kopli testnet
# See https://dev.reactive.network/kopli-testnet
REACTIVE_RPC=https://kopli-rpc.rnk.dev/

# ─── Reactive Network System Contract ──────────────────────────────────────────
# Address of the Reactive Network subscription service contract (Kopli testnet)
# See https://dev.reactive.network/kopli-testnet#system-contract
# Note: this is informational — the address is hardcoded in BasicReactive.sol
SYSTEM_CONTRACT_ADDR=0x0000000000000000000000000000000000fffFfF

# ─── Callback Proxy ────────────────────────────────────────────────────────────
# Address of the Reactive Network callback proxy on your destination chain
# See https://dev.reactive.network/origins-and-destinations#callback-proxy-address
# Sepolia callback proxy:
CALLBACK_PROXY_ADDR=0x33Bbb7D0a2F1029550B0e91f653c4055DC9F4Dd8

# ─── Deployed Contract Addresses ───────────────────────────────────────────────
# Populated after deploying the origin & callback contracts
ORIGIN_CONTRACT_ADDR=
CALLBACK_CONTRACT_ADDR=
