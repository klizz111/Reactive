{
    "name": "Foundry Codespace",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "remoteUser": "vscode",
    "forwardPorts": [
        8545
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "nomicfoundation.hardhat-vscode",
                "NomicFoundation.hardhat-solidity"
            ]
        }
    }
}
